APP_NAME=Alfa News API
DEBUG=false
API_PORT=8000
JWT_SECRET=
JWT_EXPIRE_MINUTES=1440
CSV_IMPORT_MAX_BYTES=104857600
CSV_IMPORT_MAX_ROWS=100000
CSV_IMPORT_PAYMENTS_MAX_ROWS=2000000
RSS_ENABLED=true
RSS_CONCURRENCY=4
RSS_REQUEST_TIMEOUT_SECONDS=30
RSS_MAX_RESPONSE_BYTES=5242880
RSS_LEASE_SECONDS=120
RSS_SNAPSHOT_RETENTION_DAYS=7
RSS_RUN_RETENTION_DAYS=30

# Аналитические PDF: фоновая очередь в PostgreSQL, OCR rus+eng, BGE через существующий клиент.
ANALYTICS_ENABLED=true
ANALYTICS_MAX_BYTES=52428800
ANALYTICS_MAX_PAGES=100
ANALYTICS_PARSE_TIMEOUT_SECONDS=900
ANALYTICS_OCR_DPI=200
ANALYTICS_OCR_LANGUAGES=rus+eng
ANALYTICS_EMBEDDINGS_ENABLED=true
# Для Windows укажите папку с rus.traineddata и eng.traineddata.
# В Docker путь уже настроен, языки установлены в образе.
# ANALYTICS_TESSDATA=D:/path/to/tessdata

# Credentials are for local development. Set your own values before deployment.
POSTGRES_USER=alfa_news
POSTGRES_PASSWORD=alfa_news_local
POSTGRES_DB=alfa_news
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# AI-сервисы (app/services) — LLM вызывается обычными HTTP-запросами в OpenAI-совместимый API.
# Официальный шлюз хакатона (ключ sk-... у организаторов; лимит 500 руб/день на команду, сброс 3:00 МСК;
# ключ не коммитить — держать в .env):
AI_LLM_API_BASE=https://changellenge.up.railway.app/v1
# Запасной шлюз: https://api.alfahack-gateway26.ru/v1
AI_LLM_API_KEY=
# Доступные модели (копировать имя точно):
#   google/gemma-4-26b-a4b-it
#   z-ai/glm-5.3-flash
#   qwen/qwen3.6-35b-a3b
#   deepseek/deepseek-v4.1-flash
#   qwen/qwen3-vl-30b-a3b-instruct
#   moonshotai/kimi-k2.6
# Период разработки может использовать OpenRouter: AI_LLM_API_BASE=https://openrouter.ai/api/v1
AI_LLM_MODEL=google/gemma-4-26b-a4b-it
AI_LLM_MOCK=false
AI_INTERPRETATION_TIMEOUT_SECONDS=90
AI_INTERPRETATION_CONCURRENCY=2
AI_INTERPRETATION_CACHE_HOURS=24
# Начальный набор аналитики банка, пока выбор не сохранён через PUT /analytics/bank-documents.
# Для изменений без перезапуска используйте API, UUID берите из GET /analytics/documents.
AI_BANK_DOCUMENT_IDS=[]
# Пример: AI_BANK_DOCUMENT_IDS='["uuid-1","uuid-2"]'

# Короткая оценка новости для компании в ленте (риски, возможности, аналитика банка — по 2-4
# предложения, один вызов LLM). Готовится фоном для новостей открытой страницы ленты.
AI_ASSESSMENT_ENABLED=true
AI_ASSESSMENT_CONCURRENCY=2
AI_ASSESSMENT_BANK_PASSAGES=3

# Full article bodies missing from RSS are fetched in the background.
ARTICLE_CONTENT_ENABLED=true
ARTICLE_CONTENT_CONCURRENCY=2
ARTICLE_CONTENT_POLL_SECONDS=2

# In-process durable preprocessing. Both workers use PostgreSQL leases, so the
# same API image may be scaled without processing the same item concurrently.
AI_NEWS_WORKER_ENABLED=true
AI_NEWS_WORKER_POLL_SECONDS=2
AI_NEWS_WORKER_BATCH_SIZE=8
AI_NEWS_WORKER_CONCURRENCY=2
AI_NEWS_WORKER_LEASE_SECONDS=300
AI_NEWS_WORKER_MAX_ATTEMPTS=5
AI_NEWS_WORKER_RETRY_SECONDS=30
AI_NEWS_WORKER_CONFIG_RETRY_SECONDS=300
AI_PROFILE_ENABLED=true
AI_PROFILE_POLL_SECONDS=2
AI_PROFILE_BATCH_SIZE=8
AI_PROFILE_RETRY_SECONDS=30
AI_PROFILE_LEASE_SECONDS=300

# Эмбеддинги BGE-M3 через Ollama (batch + single model во всём сервисе).
# Локальный запуск (скрипты, uvicorn на хосте) — Ollama на 127.0.0.1.
# Для контейнеров docker compose используется DOCKER_EMBED_OLLAMA_HOST
# (по умолчанию http://ollama:11434 — сервис ollama из compose.yaml, модель качает ollama-init).
AI_EMBED_OLLAMA_HOST=http://127.0.0.1:11434
# DOCKER_EMBED_OLLAMA_HOST=http://ollama:11434  # или http://host.docker.internal:11434 для Ollama на хосте
# Заглушка вместо LLM — только явно (AI_LLM_MOCK=true); без AI_LLM_API_BASE обработка новостей падает.
AI_LLM_MOCK=false
AI_EMBED_MODEL=bge-m3
AI_EMBED_DIM=1024
# Эмбеддинги: сначала шлюз (POST {AI_LLM_API_BASE}/embeddings), при любой ошибке — Ollama выше.
# Модель шлюза должна быть bge-m3 (векторы в БД от неё не зависят). Имя уточните через GET /v1/models.
AI_EMBED_GATEWAY_ENABLED=false
# AI_EMBED_GATEWAY_MODEL=bge-m3
# Реранкер шлюза (POST {AI_LLM_API_BASE}/rerank) уточняет релевантность в ленте компании;
# без модели или при сбое остаётся «косинус + веса правил».
# AI_RERANK_MODEL=
